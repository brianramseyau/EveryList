{
  "name": "everylist",
  "private": true,
  "version": "0.0.0",
  "description": "EveryList — a narrower, sharper shopping-list PWA.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev-preflight.mjs && pnpm -r --parallel dev",
    "dev:sw": "node scripts/dev-preflight.mjs && PWA_DEV=true pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "node scripts/check.mjs",
    "db:migrate": "pnpm --filter @everylist/api db:migrate",
    "db:migrate:rollback": "pnpm --filter @everylist/api db:migrate:rollback",
    "db:migrate:status": "pnpm --filter @everylist/api db:migrate:status",
    "db:migrate:fresh": "pnpm --filter @everylist/api db:migrate:fresh",
    "db:seed": "pnpm --filter @everylist/api db:seed",
    "db:setup": "pnpm --filter @everylist/api db:setup",
    "db:reset": "pnpm --filter @everylist/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
