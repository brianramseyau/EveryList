+                    backgroundIntent.putExtra(NOTIFICATION_OBJ_INTENT_KEY, localNotification.source)
+                    var backgroundFlags = PendingIntent.FLAG_CANCEL_CURRENT
+                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                        backgroundFlags = backgroundFlags or PendingIntent.FLAG_MUTABLE
+                    }
+                    PendingIntent.getBroadcast(
+                        context,
+                        id + (notificationAction.id?.hashCode() ?: 0),
+                        backgroundIntent,
+                        backgroundFlags
+                    )
+                } else {
+                    val actionIntent = buildIntent(localNotification, notificationAction.id)
+                    PendingIntent.getActivity(
+                        context,
+                        id + (notificationAction.id?.hashCode() ?: 0),
