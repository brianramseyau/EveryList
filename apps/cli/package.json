{
  "name": "@everylist/cli",
  "private": true,
  "version": "1.8.0",
  "description": "EveryList command-line client — a PAT-authenticated REST client for humans and scripts. See foundational/PLAN_33_PHASE_CLI_CLIENT.md.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "everylist": "./bin/everylist.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@everylist/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.16.0",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
