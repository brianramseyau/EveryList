# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=zKXHe-Ahdb7aPK1ylAJlRgTefktEaACi
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Auth (optional — defaults to enabled; set to false to block new
# self-service signups once initial users are set up. List-invite signups
# still work while disabled.)
# PUBLIC_SIGNUP_ENABLED=true

# Database (optional — defaults to a tmp/ file for local dev; the production
# image sets this to /config/everylist.sqlite3, see docker/Dockerfile)
# DATABASE_FILENAME=

# Note: `pnpm test` (Japa) uses its own tmp/test.sqlite3 automatically via
# .env.test, so it never touches your local dev database — see .env.test.

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Outbound email (SMTP2GO) — optional; list email-export returns a clear
# "not configured" error until these are set. Not needed for local dev.
#--------------------------------------------------------------------
# SMTP2GO_HOST=mail.smtp2go.com
# SMTP2GO_PORT=2525
# SMTP2GO_USERNAME=
# SMTP2GO_PASSWORD=
# SMTP2GO_FROM_ADDRESS=no-reply@everylist.app
# SMTP2GO_FROM_NAME=EveryList
