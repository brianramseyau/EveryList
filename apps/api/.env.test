# Loaded automatically for NODE_ENV=test (see apps/api/bin/test.ts), which
# includes plain `pnpm test`. Without this, Japa tests fall back to the same
# tmp/db.sqlite3 file that a plain `pnpm dev` session uses by default, so a
# test run truncates/migrates the same database a dev server is pointed at.
# Playwright E2E already avoids this via its own tmp/e2e.sqlite3 (see
# apps/web/playwright.config.ts) — this gives Japa tests the same isolation.
DATABASE_FILENAME=tmp/test.sqlite3
