<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Custom-scheme deep links from the home-screen widget (PLAN_18_PHASE_ANDROID_HOME_SCREEN_WIDGET.md): the "+"
                 quick-add opens everylist://lists/<id> and an item-row tap opens
                 everylist://lists/<id>/items/<itemId>. Capacitor's @capacitor/app surfaces these
                 to the web app as `appUrlOpen`, which routes them in the SPA. Host is scoped to
                 `lists` so `widget-config` still resolves to WidgetConfigActivity below. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="everylist" android:host="lists" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget provider + its data-provider service (PLAN_18_PHASE_ANDROID_HOME_SCREEN_WIDGET.md) — the
             actual refresh/toggle work runs on a background thread held open by the receiver's
             goAsync() (WidgetUpdater), not a started Service. -->
        <receiver
            android:name=".EveryListWidget"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/everylist_widget_info" />
        </receiver>

        <!-- The ListView's data provider. Must be bindable by the launcher (the widget host), hence
             exported, but only through the BIND_REMOTEVIEWS permission. -->
        <service
            android:name=".WidgetListService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true">
            <intent-filter>
                <action android:name="au.brianramsey.everylist.widget.LIST_SERVICE" />
            </intent-filter>
        </service>

        <!-- Widget configuration: launched by the launcher on placement (APPWIDGET_CONFIGURE) and
             by the in-app provisioning plugin (EveryListWidgetPlugin), which writes the minted PAT
             to private storage first — the token never travels in a loggable URI. -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>