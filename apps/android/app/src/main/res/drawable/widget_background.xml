<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card behind the widget, matching the app's paper surface — @color/widget_paper rather
     than a literal hex so this single drawable serves both light and dark mode (see
     values-night/widget_colors.xml); the widget host resolves it against its own configuration. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_paper" />
    <corners android:radius="20dp" />
</shape>