<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle rounded pill behind the "Show/Hide done" control — a tinted-accent fill at low alpha,
     so it reads as a real (if quiet) button rather than bare text floating in the header. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_pill_fill" />
    <corners android:radius="999dp" />
</shape>
