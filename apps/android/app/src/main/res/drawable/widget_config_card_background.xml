<?xml version="1.0" encoding="utf-8"?>
<!-- The floating config popup's own card — same paper surface and family of corner radius as
     widget_background.xml, plus a hairline border since this card sits on a dimmed scrim rather
     than directly on the home screen wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_paper" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
</shape>
