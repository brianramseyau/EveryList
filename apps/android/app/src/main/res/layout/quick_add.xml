<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's "+" quick-add popup (QuickAddActivity). Styled as a floating card
     (AppTheme.WidgetDialog), matching widget_config.xml, so tapping the widget's + button reads as
     an in-place popup rather than a trip into the app — see AppTheme.WidgetDialog's own doc
     comment for why. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_add_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_config_card_background"
    android:padding="20dp">

    <TextView
        android:id="@+id/quick_add_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_add_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/quick_add_input_background"
        android:hint="@string/quick_add_hint"
        android:textColorHint="@color/widget_muted"
        android:textColor="@color/widget_ink"
        android:textSize="15sp"
        android:paddingHorizontal="12dp"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:maxLines="1"
        android:singleLine="true" />

    <TextView
        android:id="@+id/quick_add_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:textColor="@color/widget_warn"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Deadline control row: a clock button that opens the date/time picker, plus a short
         preview of what's currently picked ("Sep 5, 2:30 PM" — DeadlineMath.formatDeadline's
         own formatting, matching the widget row chips). The clock lights up in the accent color
         while a deadline is picked; hidden entirely on lists with deadlines turned off
         (QuickAddActivity gates it on the widget's persisted useDeadline). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 48dp, not the icon's 40dp row-predecessor: this control opens the new deadline
             picker, so it needs the standard minimum touch target itself. -->
        <ImageButton
            android:id="@+id/quick_add_deadline"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quick_add_deadline"
            android:src="@drawable/ic_widget_clock" />

        <!-- weight=1 + ellipsize: the preview shrinks (with an ellipsis) before it can squeeze
             the Add button below its usable width at large font scales / narrow popups. -->
        <TextView
            android:id="@+id/quick_add_deadline_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/quick_add_save"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:background="@drawable/widget_config_button_primary"
            android:text="@string/quick_add_save"
            android:textAllCaps="false"
            android:textColor="@color/widget_paper"
            android:textStyle="bold"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>