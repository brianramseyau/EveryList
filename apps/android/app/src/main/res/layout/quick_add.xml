<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's "+" quick-add popup (QuickAddActivity). Styled as a floating card
     (AppTheme.WidgetDialog), matching widget_config.xml, so tapping the widget's + button reads as
     an in-place popup rather than a trip into the app — see AppTheme.WidgetDialog's own doc
     comment for why. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_config_card_background"
    android:padding="20dp">

    <TextView
        android:id="@+id/quick_add_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_add_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/quick_add_input_background"
        android:hint="@string/quick_add_hint"
        android:textColorHint="@color/widget_muted"
        android:textColor="@color/widget_ink"
        android:textSize="15sp"
        android:paddingHorizontal="12dp"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:maxLines="1"
        android:singleLine="true" />

    <TextView
        android:id="@+id/quick_add_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:textColor="@color/widget_warn"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/quick_add_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/widget_config_button_primary"
        android:text="@string/quick_add_save"
        android:textAllCaps="false"
        android:textColor="@color/widget_paper"
        android:textStyle="bold"
        android:elevation="0dp"
        android:stateListAnimator="@null" />
</LinearLayout>
