<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration screen for the EveryList widget. Shown by the launcher on widget placement, by
     the widget's own list selector (quick-switch — see WidgetConfigActivity), and by the app's
     `everylist://widget-config` deep link that carries the minted PAT. Styled as a floating card
     (AppTheme.WidgetDialog) rather than a full page — see that theme's doc comment. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="480dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_config_card_background"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_title"
            android:textColor="@color/widget_ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/config_explain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/config_explain"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/config_list_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/config_loading_lists"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />

        <!-- config_list_group's own rows (RadioButtons) are built and styled in
             WidgetConfigActivity#showLists, since they're inflated per-list at runtime. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_config_section_background">

            <RadioGroup
                android:id="@+id/config_list_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp" />
        </FrameLayout>

        <CheckBox
            android:id="@+id/config_show_completed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/widget_accent"
            android:text="@string/config_show_completed"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/config_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="@color/widget_warn"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/config_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/widget_config_button_primary"
            android:text="@string/config_save"
            android:textAllCaps="false"
            android:textColor="@color/widget_paper"
            android:textStyle="bold"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/config_open_app"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_config_button_primary"
            android:text="@string/config_open_app"
            android:textAllCaps="false"
            android:textColor="@color/widget_paper"
            android:textStyle="bold"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
