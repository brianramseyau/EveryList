<?xml version="1.0" encoding="utf-8"?>
<!-- One item row inside the widget's ListView. Tapping item_body (checkbox + text) opens the
     item in the app; tapping just the checkbox toggles completion. Both get fill-in intents
     from WidgetListViewsFactory, merged into the list's shared PendingIntent template (see
     EveryListWidget.ACTION_ITEM). They're siblings, not parent/child — a RemoteViews collection
     row only delivers clicks registered on the outer/root view when nothing nested underneath it
     is also separately registered; with both row_root (the whole row) and item_check (nested
     inside it) both calling setOnClickFillInIntent, taps anywhere outside item_check's bounds
     went nowhere; only item_check's own toggle ever fired. Splitting them into siblings under a
     plain, unregistered root fixes that.

     The "checkbox" is a plain ImageView (checked/unchecked drawable swapped by
     WidgetListViewsFactory), not a real CheckBox — RemoteViews couldn't inflate CheckBox/
     Switch/RadioButton in an App Widget until Android 12 (API 31); on every older device the
     widget host's inflate of this row threw silently and every row was stuck showing the
     generic system loading placeholder forever, with no error surfaced anywhere. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/item_check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_widget_checkbox_unchecked" />

    <LinearLayout
        android:id="@+id/item_body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:paddingLeft="6dp">

        <TextView
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/item_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Deadline chip: clock icon + label ("Today", "Today, 5:00 PM", "Overdue (Sep 4)",
             "Required by Sep 11"), colored per DeadlineMath.Chip's overdue/dueToday state (see
             WidgetListViewsFactory). Hidden entirely when the item has no deadline. -->
        <LinearLayout
            android:id="@+id/item_deadline_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/item_deadline_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_widget_clock" />

            <TextView
                android:id="@+id/item_deadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>