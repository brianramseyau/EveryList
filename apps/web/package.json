{
	"name": "@everylist/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:lighthouse": "node scripts/lighthouse-check.mjs",
		"cap:sync": "pnpm run build && cap sync",
		"cap:assets": "capacitor-assets generate --ios --android --iosProject ../ios/App --androidProject ../android --iconBackgroundColor '#f6f5f1' --iconBackgroundColorDark '#1b1d1f' --splashBackgroundColor '#f6f5f1' --splashBackgroundColorDark '#1b1d1f'",
		"cap:ios": "cap open ios",
		"cap:android": "cap open android"
	},
	"dependencies": {
		"@adonisjs/transmit-client": "^1.1.0",
		"@capacitor/android": "^8.5.0",
		"@capacitor/core": "^8.5.0",
		"@capacitor/ios": "^8.5.0",
		"@everylist/shared": "workspace:*",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@mdi/js": "^7.4.47",
		"dexie": "^4.4.4",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"sortablejs": "^1.15.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.5.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/sortablejs": "^1.15.9",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "4.1.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"playwright-lighthouse": "^4.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"workbox-build": "7.4.1",
		"workbox-window": "^7.4.1"
	}
}
